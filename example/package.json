{
  "name": "expo-line-sdk-example",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-dev-client": "~57.0.19",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:build:development:ios": "eas build --local -e development -p ios --output ./builds/build-development-$(date +%s).ipa",
    "eas:build:development:android": "eas build --local -e development -p android --output ./builds/build-development-$(date +%s).apk",
    "eas:build:production:ios": "eas build --local -e production -p ios --output ./builds/build-production-$(date +%s).ipa",
    "eas:build:production:android": "eas build --local -e production -p android --output ./builds/build-production-$(date +%s).aab",
    "eas:clean:local:artifacts": "rm -f builds/build-*.{apk,aab,ipa}"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
